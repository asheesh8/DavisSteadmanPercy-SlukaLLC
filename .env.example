# Copy this file to .env.local and fill in real values before deploying.

# Password to log into /admin (change this before going live!)
ADMIN_PASSWORD=changeme123

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-this-with-a-long-random-string

# Optional — add your Anthropic API key here to turn on the real AI chatbot.
# Get one at https://console.anthropic.com/settings/keys
# Leave blank and the chatbot will use built-in canned answers instead.
ANTHROPIC_API_KEY=
